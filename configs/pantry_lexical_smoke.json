{
  "data_dir": "data/prime_pantry",
  "feature_mode": "lexical",
  "output_dir": "runs/pantry_lexical_smoke",
  "seeds": [
    2025,
    2026
  ],
  "controls": [
    "cf",
    "uniform",
    "frequency",
    "diagnostic",
    "diagnostic_uniform_alignment",
    "diagnostic_no_conflict",
    "diagnostic_no_alignment",
    "diagnostic_loss_only",
    "diagnostic_gradient_only"
  ],
  "epochs": 2,
  "teacher_epochs": 2,
  "patience": 2,
  "batch_size": 32,
  "eval_batch": 32,
  "item_chunk_size": 4096,
  "max_len": 24,
  "d_model": 16,
  "n_heads": 2,
  "n_layers": 1,
  "dropout": 0.1,
  "max_users": 128,
  "device": "cpu"
}
